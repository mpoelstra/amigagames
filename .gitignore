# macOS and emulator metadata
.DS_Store
*.uaem

# Locally installed compilers, SDKs, and Python environments
**/.toolchain/
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]

# Generated build and release trees
**/build/
**/dist/
**/src/*.o
**/third_party/LSPlayer/build/
**/third_party/LSPlayer/benchmark.adf

# Local test evidence, historical snapshots, and logs
/backups/
**/backups/
**/baselines/
**/testresults/
**/*.log
**/*.mov
**/*.mp4

# Reference packages that are not licensed for repository redistribution
/ACM_PDF/
/ACM_PDF.lha
/WHDLoad_usr.lha

